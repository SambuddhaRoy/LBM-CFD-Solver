{
  "name": "virtual-wind-tunnel",
  "version": "3.0.0",
  "description": "Real-time GPU wind tunnel: D3Q19 lattice Boltzmann solver in Vulkan compute",
  "dependencies": [
    "vulkan-headers",
    "vulkan-loader",
    "glfw3",
    {
      "name": "imgui",
      "features": ["glfw-binding", "vulkan-binding"]
    },
    "assimp",
    "glm",
    "vk-bootstrap",
    "vulkan-memory-allocator",
    "shaderc",
    "stb"
  ]
}
